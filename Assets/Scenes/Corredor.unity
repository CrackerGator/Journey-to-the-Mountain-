  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: db7a45b4d9a1b7a4d81addab95a27fc9, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::Caixa_Dialogo
  TextoUI: {fileID: 1862825562}
  NomeUI: {fileID: 733300107}
  ImagemUI: {fileID: 1906134518}
  Fonte: {fileID: 11400000, guid: 644d1ed9b8e2b8d418fbd5638516a306, type: 2}
  ListaFalas:
  - Texto: Opa!
    NomePersonagem: 
    ImagemPersonagem: {fileID: 8488740891863128800, guid: e190098f808d5034b83e3fe4f4756f95, type: 3}
    Jogador: 1
    Som: {fileID: 8300000, guid: e5de3231568565d4fb159fa50d1e85f5, type: 3}
  - Texto: Opa!
    NomePersonagem: "Velho Jacar\xE9"
    ImagemPersonagem: {fileID: -7652416048764130487, guid: 4ee1ee102a52f8642aac1ce841f3f8bd, type: 3}
    Jogador: 0
    Som: {fileID: 8300000, guid: e5de3231568565d4fb159fa50d1e85f5, type: 3}
  - Texto: "Voc\xEA tem um irm\xE3o g\xEAmeo? "
    NomePersonagem: 
    ImagemPersonagem: {fileID: 8488740891863128800, guid: e190098f808d5034b83e3fe4f4756f95, type: 3}
    Jogador: 1
    Som: {fileID: 8300000, guid: e5de3231568565d4fb159fa50d1e85f5, type: 3}
  - Texto: "N\xE3o, porque?"
    NomePersonagem: "Velho Jacar\xE9"
    ImagemPersonagem: {fileID: -358969128, guid: 4ee1ee102a52f8642aac1ce841f3f8bd, type: 3}
    Jogador: 0
    Som: {fileID: 8300000, guid: e5de3231568565d4fb159fa50d1e85f5, type: 3}
  - Texto: "Ent\xE3o quem \xE9 esse?"
    NomePersonagem: 
    ImagemPersonagem: {fileID: -124828333, guid: e190098f808d5034b83e3fe4f4756f95, type: 3}
    Jogador: 1
    Som: {fileID: 8300000, guid: e5de3231568565d4fb159fa50d1e85f5, type: 3}
  - Texto: Esse quem?
    NomePersonagem: "Velho Jacar\xE9"
    ImagemPersonagem: {fileID: -358969128, guid: 4ee1ee102a52f8642aac1ce841f3f8bd, type: 3}
    Jogador: 0
    Som: {fileID: 8300000, guid: e5de3231568565d4fb159fa50d1e85f5, type: 3}
  - Texto: Esse do seu lado!
    NomePersonagem: 
    ImagemPersonagem: {fileID: 8488740891863128800, guid: e190098f808d5034b83e3fe4f4756f95, type: 3}
    Jogador: 1
    Som: {fileID: 8300000, guid: e5de3231568565d4fb159fa50d1e85f5, type: 3}
  - Texto: Quem, eu?
    NomePersonagem: "Velho Jacar\xE9"
    ImagemPersonagem: {fileID: -358969128, guid: 4ee1ee102a52f8642aac1ce841f3f8bd, type: 3}
    Jogador: 0
    Som: {fileID: 8300000, guid: e5de3231568565d4fb159fa50d1e85f5, type: 3}
  - Texto: "Sim, voc\xEA!"
    NomePersonagem: 
    ImagemPersonagem: {fileID: 8488740891863128800, guid: e190098f808d5034b83e3fe4f4756f95, type: 3}
    Jogador: 1
    Som: {fileID: 8300000, guid: e5de3231568565d4fb159fa50d1e85f5, type: 3}
  - Texto: "Eu sou eu, n\xE9?"
    NomePersonagem: "Velho Jacar\xE9"
    ImagemPersonagem: {fileID: -7652416048764130487, guid: 4ee1ee102a52f8642aac1ce841f3f8bd, type: 3}
    Jogador: 0
    Som: {fileID: 8300000, guid: e5de3231568565d4fb159fa50d1e85f5, type: 3}
  - Texto: Quem mais seria?!
    NomePersonagem: "Velho Jacar\xE9"
    ImagemPersonagem: {fileID: -816465996, guid: 4ee1ee102a52f8642aac1ce841f3f8bd, type: 3}
    Jogador: 0
    Som: {fileID: 8300000, guid: e5de3231568565d4fb159fa50d1e85f5, type: 3}
  - Texto: "Ent\xE3o... quem \xE9 o outro?"
    NomePersonagem: 
    ImagemPersonagem: {fileID: -124828333, guid: e190098f808d5034b83e3fe4f4756f95, type: 3}
    Jogador: 1
    Som: {fileID: 8300000, guid: e5de3231568565d4fb159fa50d1e85f5, type: 3}
  - Texto: Outro quem?
    NomePersonagem: "Velho Jacar\xE9"
    ImagemPersonagem: {fileID: -358969128, guid: 4ee1ee102a52f8642aac1ce841f3f8bd, type: 3}
    Jogador: 0
    Som: {fileID: 8300000, guid: e5de3231568565d4fb159fa50d1e85f5, type: 3}
  - Texto: ...
    NomePersonagem: 
    ImagemPersonagem: {fileID: 6717519449759683372, guid: e190098f808d5034b83e3fe4f4756f95, type: 3}
    Jogador: 1
    Som: {fileID: 8300000, guid: e5de3231568565d4fb159fa50d1e85f5, type: 3}
