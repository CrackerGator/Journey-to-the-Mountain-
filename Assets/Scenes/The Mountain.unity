  ListaFalas:
  - Texto: "Voc\xEA... sabe o que eu vou encontar l\xE1 em cima, n\xE3o sabe?"
    NomePersonagem: 
    ImagemPersonagem: {fileID: 6717519449759683372, guid: e190098f808d5034b83e3fe4f4756f95, type: 3}
    Jogador: 1
    Som: {fileID: 8300000, guid: e5de3231568565d4fb159fa50d1e85f5, type: 3}
  - Texto: Sei sim!
    NomePersonagem: "Velho Jacar\xE9"
    ImagemPersonagem: {fileID: -816465996, guid: 4ee1ee102a52f8642aac1ce841f3f8bd, type: 3}
    Jogador: 0
    Som: {fileID: 8300000, guid: e5de3231568565d4fb159fa50d1e85f5, type: 3}
  - Texto: Mas eu jamais te diria, heheheheh!
    NomePersonagem: "Velho Jacar\xE9"
    ImagemPersonagem: {fileID: 1617426678, guid: 4ee1ee102a52f8642aac1ce841f3f8bd, type: 3}
    Jogador: 0
    Som: {fileID: 8300000, guid: e5de3231568565d4fb159fa50d1e85f5, type: 3}
