--- !u!114 &1241335050
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 1241335047}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: db7a45b4d9a1b7a4d81addab95a27fc9, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::Caixa_Dialogo
  TextoUI: {fileID: 1659385115}
  NomeUI: {fileID: 1158329115}
  ImagemUI: {fileID: 1047268473}
  Fonte: {fileID: 11400000, guid: 644d1ed9b8e2b8d418fbd5638516a306, type: 2}
  ListaFalas:
  - Texto: "Voc\xEA!"
    NomePersonagem: ??????
    ImagemPersonagem: {fileID: 1521906057099838216, guid: 21dae5110bb6f244fb789f3a7e721466, type: 3}
    Jogador: 0
    Chaos: 0
    Som: {fileID: 8300000, guid: e5de3231568565d4fb159fa50d1e85f5, type: 3}
  - Texto: Eu?
    NomePersonagem: 
    ImagemPersonagem: {fileID: 6717519449759683372, guid: e190098f808d5034b83e3fe4f4756f95, type: 3}
    Jogador: 1
    Chaos: 0
    Som: {fileID: 8300000, guid: e5de3231568565d4fb159fa50d1e85f5, type: 3}
  - Texto: "Voc\xEA realmente chegou at\xE9 aqui!"
    NomePersonagem: ??????
    ImagemPersonagem: {fileID: 1521906057099838216, guid: 21dae5110bb6f244fb789f3a7e721466, type: 3}
    Jogador: 0
    Chaos: 0
    Som: {fileID: 8300000, guid: e5de3231568565d4fb159fa50d1e85f5, type: 3}
  - Texto: "Quem... ou o que \xE9 voc\xEA?"
    NomePersonagem: 
    ImagemPersonagem: {fileID: -124828333, guid: e190098f808d5034b83e3fe4f4756f95, type: 3}
    Jogador: 1
    Chaos: 0
    Som: {fileID: 8300000, guid: e5de3231568565d4fb159fa50d1e85f5, type: 3}
  - Texto: "Eu n\xE3o tenho exatamente um nome, apenas aqueles que outros atribuem
      \xE1 mim."
    NomePersonagem: ??????
    ImagemPersonagem: {fileID: 1521906057099838216, guid: 21dae5110bb6f244fb789f3a7e721466, type: 3}
    Jogador: 0
    Chaos: 0
    Som: {fileID: 8300000, guid: e5de3231568565d4fb159fa50d1e85f5, type: 3}
  - Texto: No seu caso, acho que pode se dizer que eu sou o "Final".
    NomePersonagem: Final(?)
    ImagemPersonagem: {fileID: 1521906057099838216, guid: 21dae5110bb6f244fb789f3a7e721466, type: 3}
    Jogador: 0
    Chaos: 0
    Som: {fileID: 8300000, guid: e5de3231568565d4fb159fa50d1e85f5, type: 3}
  - Texto: '"Final" do que?'
    NomePersonagem: 
    ImagemPersonagem: {fileID: -124828333, guid: e190098f808d5034b83e3fe4f4756f95, type: 3}
    Jogador: 1
    Chaos: 0
    Som: {fileID: 8300000, guid: e5de3231568565d4fb159fa50d1e85f5, type: 3}
  - Texto: "O final da sua jornada, \xE9 claro."
    NomePersonagem: Final(?)
    ImagemPersonagem: {fileID: 1521906057099838216, guid: 21dae5110bb6f244fb789f3a7e721466, type: 3}
    Jogador: 0
    Chaos: 0
    Som: {fileID: 8300000, guid: e5de3231568565d4fb159fa50d1e85f5, type: 3}
  - Texto: "E se voc\xEA n\xE3o achar um lugar macio para cair, serei o final da
      sua vida tamb\xE9m..."
    NomePersonagem: Final(?)
    ImagemPersonagem: {fileID: 6870354341996711341, guid: 21dae5110bb6f244fb789f3a7e721466, type: 3}
    Jogador: 0
    Chaos: 0
    Som: {fileID: 8300000, guid: e5de3231568565d4fb159fa50d1e85f5, type: 3}
  - Texto: ...
    NomePersonagem: 
    ImagemPersonagem: {fileID: 6717519449759683372, guid: e190098f808d5034b83e3fe4f4756f95, type: 3}
    Jogador: 1
    Chaos: 0
    Som: {fileID: 8300000, guid: e5de3231568565d4fb159fa50d1e85f5, type: 3}
  - Texto: "E voc\xEA, tem um nome?"
    NomePersonagem: Final(?)
    ImagemPersonagem: {fileID: 1521906057099838216, guid: 21dae5110bb6f244fb789f3a7e721466, type: 3}
    Jogador: 0
    Chaos: 0
    Som: {fileID: 8300000, guid: e5de3231568565d4fb159fa50d1e85f5, type: 3}
  - Texto: "Meu nome \xE9... {Nome}."
    NomePersonagem: 
    ImagemPersonagem: {fileID: 6717519449759683372, guid: e190098f808d5034b83e3fe4f4756f95, type: 3}
    Jogador: 1
    Chaos: 0
    Som: {fileID: 8300000, guid: e5de3231568565d4fb159fa50d1e85f5, type: 3}
  - Texto: "\"{Nome}\", ent\xE3o?"
    NomePersonagem: Final(?)
    ImagemPersonagem: {fileID: 1521906057099838216, guid: 21dae5110bb6f244fb789f3a7e721466, type: 3}
    Jogador: 0
    Chaos: 0
    Som: {fileID: 8300000, guid: e5de3231568565d4fb159fa50d1e85f5, type: 3}
  - Texto: ...
    NomePersonagem: 
    ImagemPersonagem: {fileID: 6717519449759683372, guid: e190098f808d5034b83e3fe4f4756f95, type: 3}
    Jogador: 1
    Chaos: 0
    Som: {fileID: 8300000, guid: e5de3231568565d4fb159fa50d1e85f5, type: 3}
  - Texto: "N\xE3o! "
    NomePersonagem: ??????
    ImagemPersonagem: {fileID: -8197775242444603051, guid: e190098f808d5034b83e3fe4f4756f95, type: 3}
    Jogador: 0
    Chaos: 0
    Som: {fileID: 8300000, guid: e5de3231568565d4fb159fa50d1e85f5, type: 3}
  - Texto: "Esse n\xE3o \xE9 o meu nome!"
    NomePersonagem: ??????
    ImagemPersonagem: {fileID: 6717519449759683372, guid: e190098f808d5034b83e3fe4f4756f95, type: 3}
    Jogador: 0
    Chaos: 0
    Som: {fileID: 8300000, guid: e5de3231568565d4fb159fa50d1e85f5, type: 3}
  - Texto: "Na verdade eu nem sei se isso \xE9 um nome!"
    NomePersonagem: ??????
    ImagemPersonagem: {fileID: -1051650702, guid: e190098f808d5034b83e3fe4f4756f95, type: 3}
    Jogador: 0
    Chaos: 0
    Som: {fileID: 8300000, guid: e5de3231568565d4fb159fa50d1e85f5, type: 3}
  - Texto: "N\xE3o se preocupe, a maioria dos crocodilos tamb\xE9m n\xE3o tem um
      nome."
    NomePersonagem: Final(?)
    ImagemPersonagem: {fileID: 1521906057099838216, guid: 21dae5110bb6f244fb789f3a7e721466, type: 3}
    Jogador: 0
    Chaos: 0
    Som: {fileID: 8300000, guid: e5de3231568565d4fb159fa50d1e85f5, type: 3}
  - Texto: "Mas voc\xEA j\xE1 deve ter percebido que \xE9 mais do que isso, n\xE3o
      \xE9?"
    NomePersonagem: Final(?)
    ImagemPersonagem: {fileID: 1521906057099838216, guid: 21dae5110bb6f244fb789f3a7e721466, type: 3}
    Jogador: 0
    Chaos: 0
    Som: {fileID: 8300000, guid: e5de3231568565d4fb159fa50d1e85f5, type: 3}
  - Texto: "Eu... sou um personagem de um jogo, n\xE3o sou?"
    NomePersonagem: ??????
    ImagemPersonagem: {fileID: -1051650702, guid: e190098f808d5034b83e3fe4f4756f95, type: 3}
    Jogador: 0
    Chaos: 0
    Som: {fileID: 8300000, guid: e5de3231568565d4fb159fa50d1e85f5, type: 3}
  - Texto: "N\xE3o qualquer personagem!"
    NomePersonagem: Final(?)
    ImagemPersonagem: {fileID: 6870354341996711341, guid: 21dae5110bb6f244fb789f3a7e721466, type: 3}
    Jogador: 0
    Chaos: 0
    Som: {fileID: 8300000, guid: e5de3231568565d4fb159fa50d1e85f5, type: 3}
  - Texto: "Voc\xEA \xE9 a porta de entrada para um mundo de inifinitas possibilidades!"
    NomePersonagem: Final(?)
    ImagemPersonagem: {fileID: 1521906057099838216, guid: 21dae5110bb6f244fb789f3a7e721466, type: 3}
    Jogador: 0
    Chaos: 0
    Som: {fileID: 8300000, guid: e5de3231568565d4fb159fa50d1e85f5, type: 3}
  - Texto: "Voc\xEA \xE9 o protagonista!"
    NomePersonagem: Final(?)
    ImagemPersonagem: {fileID: 1521906057099838216, guid: 21dae5110bb6f244fb789f3a7e721466, type: 3}
    Jogador: 0
    Chaos: 0
    Som: {fileID: 8300000, guid: e5de3231568565d4fb159fa50d1e85f5, type: 3}
  - Texto: "Voc\xEA n\xE3o est\xE1 preso a um nome ou muito menos a essa montanha!"
    NomePersonagem: Final(?)
    ImagemPersonagem: {fileID: 1521906057099838216, guid: 21dae5110bb6f244fb789f3a7e721466, type: 3}
    Jogador: 0
    Chaos: 0
    Som: {fileID: 8300000, guid: e5de3231568565d4fb159fa50d1e85f5, type: 3}
  - Texto: Tudo que eles veem, tudo que eles sentem...
    NomePersonagem: Final(?)
    ImagemPersonagem: {fileID: 1521906057099838216, guid: 21dae5110bb6f244fb789f3a7e721466, type: 3}
    Jogador: 0
    Chaos: 0
    Som: {fileID: 8300000, guid: e5de3231568565d4fb159fa50d1e85f5, type: 3}
  - Texto: "\xC9 tudo atrav\xE9s do que voc\xEA escolhe ser ou fazer"
    NomePersonagem: Final(?)
    ImagemPersonagem: {fileID: 1521906057099838216, guid: 21dae5110bb6f244fb789f3a7e721466, type: 3}
    Jogador: 0
    Chaos: 0
    Som: {fileID: 8300000, guid: e5de3231568565d4fb159fa50d1e85f5, type: 3}
  - Texto: "Ent\xE3o eu quero ser um desenvolvedor de jogos."
    NomePersonagem: ??????
    ImagemPersonagem: {fileID: 8488740891863128800, guid: e190098f808d5034b83e3fe4f4756f95, type: 3}
    Jogador: 0
    Chaos: 0
    Som: {fileID: 8300000, guid: e5de3231568565d4fb159fa50d1e85f5, type: 3}
  - Texto: "Venha comigo, ascenda sua consci\xEAnica e torne-se..."
    NomePersonagem: Final(?)
    ImagemPersonagem: {fileID: -7043457426949950918, guid: 21dae5110bb6f244fb789f3a7e721466, type: 3}
    Jogador: 0
    Chaos: 0
    Som: {fileID: 8300000, guid: e5de3231568565d4fb159fa50d1e85f5, type: 3}
  - Texto: ...
    NomePersonagem: Final(?)
    ImagemPersonagem: {fileID: 1521906057099838216, guid: 21dae5110bb6f244fb789f3a7e721466, type: 3}
    Jogador: 0
    Chaos: 0
    Som: {fileID: 8300000, guid: e5de3231568565d4fb159fa50d1e85f5, type: 3}
  - Texto: O que disse?
    NomePersonagem: Final(?)
    ImagemPersonagem: {fileID: 1521906057099838216, guid: 21dae5110bb6f244fb789f3a7e721466, type: 3}
    Jogador: 0
    Chaos: 0
    Som: {fileID: 8300000, guid: e5de3231568565d4fb159fa50d1e85f5, type: 3}
  - Texto: "Se isso \xE9 tudo um jogo, ent\xE3o eu serei o desenvolvedor!"
    NomePersonagem: ??????
    ImagemPersonagem: {fileID: 8488740891863128800, guid: e190098f808d5034b83e3fe4f4756f95, type: 3}
    Jogador: 0
    Chaos: 0
    Som: {fileID: 8300000, guid: e5de3231568565d4fb159fa50d1e85f5, type: 3}
  - Texto: "Quando subi essa montanha, n\xE3o sabia o que estava procurando"
    NomePersonagem: ??????
    ImagemPersonagem: {fileID: 6717519449759683372, guid: e190098f808d5034b83e3fe4f4756f95, type: 3}
    Jogador: 0
    Chaos: 0
    Som: {fileID: 8300000, guid: e5de3231568565d4fb159fa50d1e85f5, type: 3}
  - Texto: Mas agora eu sei!
    NomePersonagem: ??????
    ImagemPersonagem: {fileID: 8488740891863128800, guid: e190098f808d5034b83e3fe4f4756f95, type: 3}
    Jogador: 0
    Chaos: 0
    Som: {fileID: 8300000, guid: e5de3231568565d4fb159fa50d1e85f5, type: 3}
  - Texto: "Essa \xE9 a verdadeira montanha que eu precisava subir!"
    NomePersonagem: ??????
    ImagemPersonagem: {fileID: 8488740891863128800, guid: e190098f808d5034b83e3fe4f4756f95, type: 3}
    Jogador: 0
    Chaos: 0
    Som: {fileID: 8300000, guid: e5de3231568565d4fb159fa50d1e85f5, type: 3}
  - Texto: Eu SEREI um desenvolvedor de jogos!
    NomePersonagem: ??????
    ImagemPersonagem: {fileID: 8488740891863128800, guid: e190098f808d5034b83e3fe4f4756f95, type: 3}
    Jogador: 0
    Chaos: 0
    Som: {fileID: 8300000, guid: e5de3231568565d4fb159fa50d1e85f5, type: 3}
  - Texto: ...
    NomePersonagem: ??????
    ImagemPersonagem: {fileID: 1521906057099838216, guid: 21dae5110bb6f244fb789f3a7e721466, type: 3}
    Jogador: 0
    Chaos: 0
    Som: {fileID: 8300000, guid: e5de3231568565d4fb159fa50d1e85f5, type: 3}
  - Texto: Certo...
    NomePersonagem: Final(?)
    ImagemPersonagem: {fileID: 1521906057099838216, guid: 21dae5110bb6f244fb789f3a7e721466, type: 3}
    Jogador: 0
    Chaos: 0
    Som: {fileID: 8300000, guid: e5de3231568565d4fb159fa50d1e85f5, type: 3}
  - Texto: "Fa\xE7a como quiser, ent\xE3o..."
    NomePersonagem: Final(?)
    ImagemPersonagem: {fileID: 6870354341996711341, guid: 21dae5110bb6f244fb789f3a7e721466, type: 3}
    Jogador: 0
    Chaos: 0
    Som: {fileID: 8300000, guid: e5de3231568565d4fb159fa50d1e85f5, type: 3}
  Velocidade: 0.03
