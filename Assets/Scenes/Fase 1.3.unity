--- !u!114 &1021745075
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 1021745073}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: db7a45b4d9a1b7a4d81addab95a27fc9, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::Caixa_Dialogo
  TextoUI: {fileID: 1443583517}
  NomeUI: {fileID: 1819816417}
  ImagemUI: {fileID: 532868012}
  ListaFalas:
  - Texto: Ei! Aonde vai com tanta pressa?!
    NomePersonagem: Rei Crocodilo
    ImagemPersonagem: {fileID: 1741502828639605652, guid: 289cba3ddf194ca4e85f4b602195706f, type: 3}
    Jogador: 0
    Fonte: {fileID: 12800000, guid: df9770868e037bd448ca94a3f7070a69, type: 3}
    Som: {fileID: 8300000, guid: e5de3231568565d4fb159fa50d1e85f5, type: 3}
  - Texto: Eu preciso chegar no topo da montanha!
    NomePersonagem: 
    ImagemPersonagem: {fileID: 8488740891863128800, guid: e190098f808d5034b83e3fe4f4756f95, type: 3}
    Jogador: 1
    Fonte: {fileID: 12800000, guid: df9770868e037bd448ca94a3f7070a69, type: 3}
    Som: {fileID: 8300000, guid: e5de3231568565d4fb159fa50d1e85f5, type: 3}
  - Texto: "O topo da montanha \xE9 pro\xEDbido!"
    NomePersonagem: Rei Crocodilo
    ImagemPersonagem: {fileID: 1741502828639605652, guid: 289cba3ddf194ca4e85f4b602195706f, type: 3}
    Jogador: 0
    Fonte: {fileID: 12800000, guid: df9770868e037bd448ca94a3f7070a69, type: 3}
    Som: {fileID: 8300000, guid: e5de3231568565d4fb159fa50d1e85f5, type: 3}
  - Texto: Volte para o seu laguinho, imediatamente!
    NomePersonagem: Rei Crocodilo
    ImagemPersonagem: {fileID: 7670190944150385041, guid: 289cba3ddf194ca4e85f4b602195706f, type: 3}
    Jogador: 0
    Fonte: {fileID: 12800000, guid: df9770868e037bd448ca94a3f7070a69, type: 3}
    Som: {fileID: 8300000, guid: e5de3231568565d4fb159fa50d1e85f5, type: 3}
  - Texto: "E voc\xEA \xE9 o famoso \"quem\"?  "
    NomePersonagem: 
    ImagemPersonagem: {fileID: -124828333, guid: e190098f808d5034b83e3fe4f4756f95, type: 3}
    Jogador: 1
    Fonte: {fileID: 12800000, guid: df9770868e037bd448ca94a3f7070a69, type: 3}
    Som: {fileID: 8300000, guid: e5de3231568565d4fb159fa50d1e85f5, type: 3}
  - Texto: 'Quem sou eu?! '
    NomePersonagem: Rei Crocodilo
    ImagemPersonagem: {fileID: 1741502828639605652, guid: 289cba3ddf194ca4e85f4b602195706f, type: 3}
    Jogador: 0
    Fonte: {fileID: 12800000, guid: df9770868e037bd448ca94a3f7070a69, type: 3}
    Som: {fileID: 8300000, guid: e5de3231568565d4fb159fa50d1e85f5, type: 3}
  - Texto: "Eu sou o absoluto soberano da floresta, o supremo predador do p\xE2ntano!"
    NomePersonagem: Rei Crocodilo
    ImagemPersonagem: {fileID: 7670190944150385041, guid: 289cba3ddf194ca4e85f4b602195706f, type: 3}
    Jogador: 0
    Fonte: {fileID: 12800000, guid: df9770868e037bd448ca94a3f7070a69, type: 3}
    Som: {fileID: 8300000, guid: e5de3231568565d4fb159fa50d1e85f5, type: 3}
  - Texto: "O maior r\xE9ptil a caminhar sob a terra!"
    NomePersonagem: Rei Crocodilo
    ImagemPersonagem: {fileID: 7670190944150385041, guid: 289cba3ddf194ca4e85f4b602195706f, type: 3}
    Jogador: 0
    Fonte: {fileID: 12800000, guid: df9770868e037bd448ca94a3f7070a69, type: 3}
    Som: {fileID: 8300000, guid: e5de3231568565d4fb159fa50d1e85f5, type: 3}
  - Texto: O grande Rei Crocodilo! Muahahahahahah!
    NomePersonagem: Rei Crocodilo
    ImagemPersonagem: {fileID: 2765065122675622045, guid: 289cba3ddf194ca4e85f4b602195706f, type: 3}
    Jogador: 0
    Fonte: {fileID: 12800000, guid: df9770868e037bd448ca94a3f7070a69, type: 3}
    Som: {fileID: 8300000, guid: e5de3231568565d4fb159fa50d1e85f5, type: 3}
  - Texto: "Ent\xE3o, a \"vossa majestade\" vai me deixar passar ou..."
    NomePersonagem: 
    ImagemPersonagem: {fileID: 1467770775, guid: e190098f808d5034b83e3fe4f4756f95, type: 3}
    Jogador: 1
    Fonte: {fileID: 12800000, guid: df9770868e037bd448ca94a3f7070a69, type: 3}
    Som: {fileID: 8300000, guid: e5de3231568565d4fb159fa50d1e85f5, type: 3}
  - Texto: "Voc\xEA zomba de mim, pequeno jacar\xE9?"
    NomePersonagem: Rei Crocodilo
    ImagemPersonagem: {fileID: 1741502828639605652, guid: 289cba3ddf194ca4e85f4b602195706f, type: 3}
    Jogador: 0
    Fonte: {fileID: 12800000, guid: df9770868e037bd448ca94a3f7070a69, type: 3}
    Som: {fileID: 8300000, guid: e5de3231568565d4fb159fa50d1e85f5, type: 3}
  - Texto: Talvez eu deva te mostrar porque EU sou rei!
    NomePersonagem: Rei Crocodilo
    ImagemPersonagem: {fileID: 7670190944150385041, guid: 289cba3ddf194ca4e85f4b602195706f, type: 3}
    Jogador: 0
    Fonte: {fileID: 12800000, guid: df9770868e037bd448ca94a3f7070a69, type: 3}
    Som: {fileID: 8300000, guid: e5de3231568565d4fb159fa50d1e85f5, type: 3}
  - Texto: ...
    NomePersonagem: 
    ImagemPersonagem: {fileID: 6717519449759683372, guid: e190098f808d5034b83e3fe4f4756f95, type: 3}
    Jogador: 1
    Fonte: {fileID: 12800000, guid: df9770868e037bd448ca94a3f7070a69, type: 3}
    Som: {fileID: 8300000, guid: e5de3231568565d4fb159fa50d1e85f5, type: 3}
  - Texto: Eu VOU chegar no topo da montanha!
    NomePersonagem: 
    ImagemPersonagem: {fileID: -8197775242444603051, guid: e190098f808d5034b83e3fe4f4756f95, type: 3}
    Jogador: 1
    Fonte: {fileID: 12800000, guid: df9770868e037bd448ca94a3f7070a69, type: 3}
    Som: {fileID: 8300000, guid: e5de3231568565d4fb159fa50d1e85f5, type: 3}
